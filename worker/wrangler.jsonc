{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lunear-games-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  // Password for the single seeded admin account (S4). Set via
  // `wrangler secret put ADMIN_PASSWORD` before deploy; wrangler blocks
  // deploy without it. Locally, put it in worker/.dev.vars (gitignored) —
  // omitting it there only warns, and ensureAdminSeeded() skips silently.
  "secrets": { "required": ["ADMIN_PASSWORD"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lunear_games",
      "database_id": "ca24a851-f7f2-4887-a232-e40dfc318c20"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "GAME_TABLE_DO", "class_name": "GameTableDO" },
      { "name": "LOBBY_DO", "class_name": "LobbyDO" },
      { "name": "LIARSBAR_TABLE_DO", "class_name": "LiarsBarTableDO" },
      { "name": "POKER_TABLE_DO", "class_name": "PokerTableDO" },
      { "name": "BLACKJACK_TABLE_DO", "class_name": "BlackjackTableDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameTableDO"] },
    { "tag": "v2", "new_sqlite_classes": ["LobbyDO"] },
    { "tag": "v3", "new_sqlite_classes": ["LiarsBarTableDO"] },
    { "tag": "v4", "new_sqlite_classes": ["PokerTableDO"] },
    { "tag": "v5", "new_sqlite_classes": ["BlackjackTableDO"] }
  ],
  "routes": [
    { "pattern": "lunear.org", "custom_domain": true },
    { "pattern": "www.lunear.org", "custom_domain": true }
  ],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
