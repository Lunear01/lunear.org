{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lunear-games-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  // Password for the single seeded admin account (S4). Set via
  // `wrangler secret put ADMIN_PASSWORD` before deploy; wrangler blocks
  // deploy without it. Locally, put it in worker/.dev.vars (gitignored) —
  // omitting it there only warns, and ensureAdminSeeded() skips silently.
  "secrets": { "required": ["ADMIN_PASSWORD"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lunear_games",
      // Placeholder — real id created and wired in S2/S10.
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "GAME_TABLE_DO", "class_name": "GameTableDO" },
      { "name": "LOBBY_DO", "class_name": "LobbyDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameTableDO"] },
    { "tag": "v2", "new_sqlite_classes": ["LobbyDO"] }
  ],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
